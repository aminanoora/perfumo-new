<header class="topbar">

  
  <div class="topbar-left">

    <div class="avatar">

      <% if (user && user.avatar) { %>
        <img src="<%= user.avatar %>" alt="profile">
      <% } else { %>
        <div class="avatar-fallback">
          <i class="fa-solid fa-user"></i>
        </div>
      <% } %>

    </div>

    <div class="user-info">
      <span class="username">
        <%= user && user.name ? user.name : "Admin" %>
      </span>
    </div>

  

  </div>

  
 

  
  <div class="topbar-right">

    

  </div>

</header>
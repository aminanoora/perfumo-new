<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Coupon Details</title>

<link rel="stylesheet" href="/admin/css/admin.css">
<link rel="stylesheet" href="/admin/css/coupon-details.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

<%- include("../partials/header") %>

<div class="page">

<%- include("../partials/sidebar") %>

<div class="content">

<div class="page-header">

<div>

<h2>Coupon Details</h2>

<p>View and manage coupon.</p>

</div>

<div class="header-actions">

<a href="/admin/coupons" class="btn btn-secondary">

<i class="fa-solid fa-arrow-left"></i>

Back

</a>

</div>

</div>

<div class="card">

<form id="couponForm">

<input
type="hidden"
id="couponId"
value="<%= coupon._id %>"
>


<div class="form-grid">

<div class="form-group">

<label>Coupon Code</label>

<input
type="text"
name="code"
value="<%= coupon.code %>"

>
<small class="error-text"></small>

</div>

<div class="form-group">

<label>Description</label>

<input
type="text"
name="description"
value="<%= coupon.description %>"

>
<small class="error-text"></small>
</div>

<div class="form-group">

<label>Discount Type</label>

<select
name="discountType"
id="discountType"

>

<option
value="percentage"
<%= coupon.discountType==="percentage" ? "selected":"" %>>
Percentage
</option>

<option
value="fixed"
<%= coupon.discountType==="fixed" ? "selected":"" %>>
Fixed Amount
</option>

</select>
<small class="error-text"></small>

</div>

<div class="form-group">

<label>Discount</label>

<input
type="number"
name="discount"
value="<%= coupon.discount %>"

>
<small class="error-text"></small>

</div>

<div class="form-group">

<label>Minimum Purchase</label>

<input
type="number"
name="minimumPurchase"
value="<%= coupon.minimumPurchase %>"
>

<small class="error-text"></small>

</div>

<div class="form-group">

<label>Maximum Discount</label>

<input
type="number"
name="maximumDiscount"
id="maximumDiscount"
value="<%= coupon.maximumDiscount %>"
>

<small class="error-text"></small>
</div>

<div class="form-group">

<label>Usage Limit</label>

<input
type="number"
name="usageLimit"
value="<%= coupon.usageLimit %>"
>
<small class="error-text"></small>
</div>

<div class="form-group">

<label>Used Count</label>

<input
type="number"
value="<%= coupon.usedCount %>"
readonly
>

<small class="error-text"></small>
</div>

<div class="form-group">

<label>Valid From</label>

<input
type="date"
name="validFrom"
value="<%= coupon.validFrom.toISOString().split('T')[0] %>"

>

<small class="error-text"></small>

</div>

<div class="form-group">

<label>Valid Until</label>

<input
type="date"
name="validUntil"
value="<%= coupon.validUntil.toISOString().split('T')[0] %>"

>

<small class="error-text"></small>

</div>

<div class="form-group">

<label>Status</label>

<select name="isActive">

<option
value="true"
<%= coupon.isActive ? "selected":"" %>>
Active
</option>

<option
value="false"
<%= !coupon.isActive ? "selected":"" %>>
Disabled
</option>

</select>

<small class="error-text"></small>

</div>

<div class="form-group">

<label>Created</label>

<input
type="text"
value="<%= coupon.createdAt.toLocaleString('en-IN') %>"
readonly
>

<small class="error-text"></small>

</div>

<div class="form-group">

<label>Last Updated</label>

<input
type="text"
value="<%= coupon.updatedAt.toLocaleString('en-IN') %>"
readonly
>

<small class="error-text"></small>

</div>

</div>

<div class="form-footer">

<button
type="submit"
class="btn btn-primary">

<i class="fa-solid fa-floppy-disk"></i>

Save Changes

</button>

<button
type="button"
id="toggleCoupon"
data-id="<%= coupon._id %>"
class="btn <%= coupon.isActive ? 'btn-danger':'btn-success' %>">

<%= coupon.isActive ? "Disable Coupon":"Enable Coupon" %>

</button>

</div>

</form>

</div>



</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/admin/js/coupon-details.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Variant</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/admin.css">
    <link rel="stylesheet" href="/admin/css/add-variant.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

    <%- include("../partials/header") %>

        <div class="page">

            <%- include("../partials/sidebar") %>

                <main class="content">

                    <form id="variantForm" action="/admin/product/<%= product._id %>/add-variant" method="POST"
                        enctype="multipart/form-data">

                        <div class="page-header">

                            <div>

                                <h1 class="h1">Add Variant</h1>

                                <p>Add a perfume variant with images</p>

                            </div>

                            <div class="header-actions">



                                <button type="submit" class="save-btn">
                                    Save Variant
                                </button>

                            </div>

                        </div>

                        <div class="variant-card">

                            <div class="left-section">

                                <h2>General Information</h2>

                                <div class="form-group">

                                    <label>SKU</label>

                                    <input type="text" name="sku" id="sku" placeholder="SKU">

                                    <span class="error" id="skuError"></span>

                                </div>

                                <div class="row">

                                    <div class="form-group">

                                        <label>Size (mL)</label>

                                        <input type="number" name="size" id="size">

                                        <span class="error" id="sizeError"></span>

                                    </div>

                                    <div class="form-group">

                                        <label>Concentration</label>

                                        <select name="concentration" id="concentration">

                                            <option value="">Select</option>

                                            <option value="EDP">EDP</option>

                                            <option value="EDT">EDT</option>

                                            <option value="EDC">EDC</option>

                                            <option value="Mist/Fraiche">Mist/Fraiche</option>

                                        </select>

                                        <span class="error" id="concentrationError"></span>

                                    </div>

                                </div>

                                <div class="row">

                                    <div class="form-group">

                                        <label>Stock</label>

                                        <input type="number" name="stock" id="stock">

                                        <span class="error" id="stockError"></span>

                                    </div>

                                    <div class="form-group">

                                        <label>Weight (g)</label>

                                        <input type="number" name="weight" id="weight">

                                        <span class="error" id="weightError"></span>

                                    </div>

                                </div>

                                <div class="row">

                                    <div class="form-group">

                                        <label>Price (₹)</label>

                                        <input type="number" step="0.01" name="price" id="price">

                                        <span class="error" id="priceError"></span>

                                    </div>

                                    <div class="form-group">

                                        <label>Sale Price (₹)</label>

                                        <input type="number" step="0.01" name="salePrice" id="salePrice">

                                        <span class="error" id="salePriceError"></span>

                                    </div>

                                </div>

                            </div>

                            <div class="right-section">

                                <h3>Product Images</h3>

                                <div class="product-upload">

                                    <input type="file" id="images" name="images" accept="image/*" multiple hidden>

                                    <div class="upload-box" id="uploadBox">

                                        <div class="upload-preview">

                                            <div class="upload-placeholder">

                                                <i class="fa-solid fa-cloud-arrow-up"></i>

                                                <h4>Upload Product Images</h4>

                                                <p>Minimum 3 and Maximum 5 Images</p>

                                                <button type="button" class="browse-btn" id="browseBtn">

                                                    Browse Files

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                    <small class="error" id="imageError"></small>

                                    <div class="preview-grid" id="previewGrid"></div>

                                </div>

                            </div>
                            <div class="modal fade" id="cropModal" tabindex="-1">

                                <div class="modal-dialog modal-lg modal-dialog-centered">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Crop Image
                                            </h5>

                                            <button type="button" class="btn-close" data-bs-dismiss="modal">
                                            </button>

                                        </div>

                                        <div class="modal-body">

                                            <div class="crop-container">

                                                <img id="cropImage" src="">

                                            </div>

                                        </div>

                                        <div class="modal-footer">

                                            <div class="crop-controls">

                                                <button type="button" id="rotateLeft">

                                                    <i class="bi bi-arrow-counterclockwise"></i>

                                                </button>

                                                <button type="button" id="rotateRight">

                                                    <i class="bi bi-arrow-clockwise"></i>

                                                </button>

                                                <button type="button" id="zoomIn">

                                                    <i class="bi bi-zoom-in"></i>

                                                </button>

                                                <button type="button" id="zoomOut">

                                                    <i class="bi bi-zoom-out"></i>

                                                </button>

                                                <button type="button" id="resetCrop">

                                                    Reset

                                                </button>

                                            </div>

                                            <button type="button" class="btn btn-primary" id="cropSave">

                                                Crop & Save

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="variant-list-card">

                                <div class="variant-list-header">

                                    <div>

                                        <h2>Added Variants</h2>

                                        <p>Variants created for this product</p>

                                    </div>

                                </div>

                                <% if (variants && variants.length) { %>

                                    <div class="table-wrapper">


                                        <div class="header-actions">

                                            <a href="/admin/product" class="back-btn">
                                                Back to Products
                                            </a>


                                        </div>
                                        <table class="variant-table">

                                            <thead>

                                                <tr>

                                                    <th>SKU</th>

                                                    <th>Size</th>

                                                    <th>Concentration</th>

                                                    <th>Price</th>

                                                    <th>Stock</th>

                                                    <th>Images</th>

                                                    <th></th>

                                                </tr>

                                            </thead>

                                            <tbody>

                                                <% variants.forEach(variant=> { %>

                                                    <tr>

                                                        <td>
                                                            <%= variant.sku %>
                                                        </td>

                                                        <td>
                                                            <%= variant.size %> ml
                                                        </td>

                                                        <td>
                                                            <%= variant.concentration %>
                                                        </td>

                                                        <td>₹<%= variant.price %>
                                                        </td>

                                                        <td>
                                                            <%= variant.stock %>
                                                        </td>

                                                        <td>

                                                            <div class="table-images">

                                                                <% variant.images.slice(0,3).forEach(image=> { %>

                                                                    <img src="/admin/uploads/products/<%= image %>"
                                                                        class="table-image previewImage">

                                                                    <% }) %>

                                                            </div>
                                                        </td>

                                                        <td>

                                                            <div class="dropdown">

                                                                <button class="action-btn" type="button"
                                                                    data-bs-toggle="dropdown">

                                                                    <i class="bi bi-three-dots-vertical"></i>

                                                                </button>

                                                                <ul class="dropdown-menu dropdown-menu-end">

                                                                    <li>
                                                                        <a class="dropdown-item"
                                                                            href="/admin/variant/<%= variant._id %>/edit">
                                                                            <i class="bi bi-pencil-square me-2"></i>
                                                                            Edit
                                                                        </a>
                                                                    </li>

                                                                    <li>

                                                                        <a href="#"
                                                                            class="dropdown-item text-danger deleteVariant"
                                                                            data-id="<%= variant._id %>">

                                                                            <i class="bi bi-trash me-2"></i>

                                                                            Delete

                                                                        </a>

                                                                    </li>

                                                                </ul>

                                                            </div>

                                                        </td>

                                                    </tr>

                                                    <% }) %>

                                            </tbody>

                                        </table>

                                        <div class="modal fade" id="imagePreviewModal" tabindex="-1">

                                            <div class="modal-dialog modal-dialog-centered">

                                                <div class="modal-content">

                                                    <div class="modal-body p-2">

                                                        <img id="previewModalImage" src="" class="img-fluid rounded">

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <% } else { %>

                                        <div class="empty-variants">

                                            <i class="bi bi-box-seam"></i>

                                            <p>No variants added yet.</p>

                                        </div>

                                        <% } %>

                            </div>

                    </form>


                </main>

        </div>

        <script>

            const message = <%= JSON.stringify(message || null) %>;

            if (message) {

                Swal.fire({

                    icon: message.type,

                    title: message.text,

                    confirmButtonColor: "#096DB9"

                });

            }

        </script>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


        <script src="/admin/js/add-variant.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Details</title>

    <link rel="stylesheet" href="/admin/css/admin.css">
    <link rel="stylesheet" href="/admin/css/product-details.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

    <%- include("../partials/header") %>

        <div class="page">

            <%- include("../partials/sidebar") %>

                <main class="content">

                    <div class="page-header">

                        <div>

                            <h2>Product Details</h2>

                            <p>Edit product information and manage variants.</p>

                        </div>

                        <div class="header-actions">

                            <button type="submit" form="productForm" class="save-btn">


                                Save Product

                            </button>



                        </div>

                    </div>

                    <form id="productForm" action="/admin/product/<%= product._id %>/update" method="POST">

                        <div class="product-card">



                            <div class="product-info">

                                <div class="form-group">


                                    <label>Product Name</label>

                                    <input type="text" name="productName" value="<%= product.name %>">

                                    <small id="productNameError" class="error"></small>
                                </div>
                                <div class="form-group">

                                    <label>Brand</label>

                                    <select name="brand">

                                        <% brands.forEach(brand=>{ %>

                                            <option value="<%= brand._id %>" <%=String(product.brand)==String(brand._id)
                                                ? "selected" :"" %>>

                                                <%= brand.name %>

                                            </option>

                                            <% }) %>

                                    </select>
                                    <small id="brandError" class="error"></small>

                                </div>

                                <div class="form-group">

                                    <label>Category</label>



                                    <select name="category">

                                        <% categories.forEach(category=>{ %>

                                            <option value="<%= category._id %>"
                                                <%=String(product.category)==String(category._id) ? "selected" :"" %>>

                                                <%= category.name %>
                                            </option>

                                            <% }) %>

                                    </select>
                                    <small id="categoryError" class="error"></small>

                                </div>
                                <div class="form-group">

                                    <label>Featured Type</label>

                                    <select name="featuredType">
                                        <% featuredTypes.forEach(item=> { %>
                                            <option value="<%= item.value %>" <%=product.featuredType===item.value
                                                ? "selected" : "" %>>
                                                <%= item.label %>
                                            </option>
                                            <% }) %>
                                    </select>

                                </div>


                                <div class="form-group full">

                                    <label>Description</label>

                                    <textarea name="description" rows="6"><%= product.description %></textarea>
                                    <small id="descriptionError" class="error"></small>
                                </div>

                                <div class="status-row">

                                    <span class="status
<%= product.isListed ? 'listed':'unlisted' %>">

                                        <%= product.isListed ? "Listed" :"Unlisted" %>

                                    </span>

                                    <div class="action-buttons">

                                        <button type="submit" formaction="/admin/product/<%= product._id %>/toggle-list"
                                            class="list-btn">

                                            <%= product.isListed ? "Unlist" :"List" %>

                                        </button>

                                        <button type="submit" formaction="/admin/product/<%= product._id %>/delete"
                                            class="delete-btn">

                                            Delete

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </form>

                    <div class="table-card">

                        <div class="table-header">

                            <h3>Variants</h3>

                            <a href="/admin/product/<%= product._id %>/add-variant" class="table-add">


                                Add Variant

                            </a>

                        </div>

                        <table>

                            <thead>

                                <tr>

                                    <th>SKU</th>

                                    <th>Size</th>

                                    <th>Concentration</th>

                                    <th>Stock</th>

                                    <th>Price</th>

                                    <th>Status</th>

                                    <th></th>

                                </tr>

                            </thead>

                            <tbody>

                                <% variants.forEach(variant=>{ %>

                                    <tr>

                                        <td>
                                            <%= variant.sku %>
                                        </td>

                                        <td>
                                            <%= variant.size %> ml
                                        </td>

                                        <td>
                                            <%= variant.concentration %>
                                        </td>

                                        <td>
                                            <%= variant.stock %>
                                        </td>

                                        <td>₹<%= variant.price %>
                                        </td>

                                        <td>

                                            <span class="<%= variant.stock>0 ? 'instock':'outstock' %>">

                                                <%= variant.stock>0 ? "In Stock":"Out of Stock" %>

                                            </span>

                                        </td>

                                        <td>

                                            <div class="dropdown">

                                                <button class="menu-btn">

                                                    <i class="fa-solid fa-ellipsis"></i>

                                                </button>

                                                <div class="dropdown-menu">



                                                    <a href="/admin/variant/<%= variant._id %>/edit">

                                                        View Details

                                                    </a>

                                                    <button class="deleteVariant" data-id="<%= variant._id %>">

                                                        Delete

                                                    </button>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                </main>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="/admin/js/product-details.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>

            const message =<% - JSON.stringify(message || null) %>;

            if (message) {

                Swal.fire({

                    icon: message.type,

                    title: message.text,

                    timer: 2000,

                    showConfirmButton: false

                });

            }

        </script>

</body>

</html>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Variant</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/admin/css/admin.css">
<link rel="stylesheet" href="/admin/css/add-variant.css">
<link rel="stylesheet" href="/admin/css/edit-variant.css">

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">





</head>

<body>

<%- include("../partials/header") %>

<div class="page">

<%- include("../partials/sidebar") %>

<main class="content">

<div class="page-header">

<div>

<h2>Edit Variant</h2>

<p>Update the details of this product variant.</p>

</div>

<div>

<button
type="submit"
form="editVariantForm"
class="save-btn">

<i class="fa-solid fa-floppy-disk"></i>

Save Variant

</button>

</div>

</div>



<form

id="editVariantForm"

action="/admin/variant/<%= variant._id %>/edit"

method="POST"

enctype="multipart/form-data">

<div class="form-card">

<h4>

Variant Information

</h4>

<div class="form-grid">

<div class="form-group">

<label>

SKU

</label>

<input
type="text"
name="sku"
id="sku"
value="<%= variant.sku %>">

<span
class="error"
id="skuError">

</span>

</div>

<div class="form-group">

<label>

Bottle Size

</label>

<select
name="size"
id="size">

<option
value="30"
<%= variant.size===30 ? "selected" : "" %>>

30 ml

</option>

<option
value="50"
<%= variant.size===50 ? "selected" : "" %>>

50 ml

</option>

<option
value="100"
<%= variant.size===100 ? "selected" : "" %>>

100 ml

</option>

<option
value="150"
<%= variant.size===150 ? "selected" : "" %>>

150 ml

</option>

<option
value="200"
<%= variant.size===200 ? "selected" : "" %>>

200 ml

</option>

</select>

<span
class="error"
id="sizeError">

</span>

</div>

<div class="form-group">

<label>

Concentration

</label>

<select
name="concentration"
id="concentration">

<option
value="EDP"
<%= variant.concentration==="EDP" ? "selected" : "" %>>

EDP

</option>

<option
value="EDT"
<%= variant.concentration==="EDT" ? "selected" : "" %>>

EDT

</option>

<option
value="EDC"
<%= variant.concentration==="EDC" ? "selected" : "" %>>

EDC

</option>

<option
value="Mist/Fraiche"
<%= variant.concentration==="Mist/Fraiche" ? "selected" : "" %>>

Mist / Fraiche

</option>

</select>

<span
class="error"
id="concentrationError">

</span>

</div>

<div class="form-group">

<label>

Stock

</label>

<input
type="number"
name="stock"
id="stock"
value="<%= variant.stock %>">

<span
class="error"
id="stockError">

</span>

</div>

<div class="form-group">

<label>

Weight (g)

</label>

<input
type="number"
name="weight"
id="weight"
value="<%= variant.weight %>">

<span
class="error"
id="weightError">

</span>

</div>
 </div>

</div>

<div class="form-card">

    <h4>Pricing</h4>

    <div class="form-grid">

        <div class="form-group">

            <label>Regular Price</label>

            <input
                type="number"
                name="price"
                id="price"
                value="<%= variant.price %>">

            <span class="error" id="priceError"></span>

        </div>

        <div class="form-group">

            <label>Sale Price</label>

            <input
                type="number"
                name="salePrice"
                id="salePrice"
                value="<%= variant.salePrice %>">

            <span class="error" id="salePriceError"></span>

        </div>

    </div>

</div>



<div class="form-card">

    <h4>Product Images</h4>

    <p class="image-note">
        Minimum 3 images and maximum 5 images.
    </p>

    <div class="existing-images">

        <% variant.images.forEach((image,index)=>{ %>

        <div class="image-box">
<img
     src="/admin/uploads/products/<%= image %>"
    alt="">

            <button
                type="button"
                class="removeExistingImage"
                data-index="<%= index %>">

                <i class="fa-solid fa-xmark"></i>

            </button>

            <input
                type="hidden"
                name="existingImages"
                value="<%= image %>">

        </div>

        <% }) %>

    </div>

<div
        id="previewContainer"
        class="preview-grid">



    </div>

    



    <div class="upload-box">

        <label
            for="variantImages"
            class="upload-label">

            <i class="fa-solid fa-cloud-arrow-up"></i>

            <span>Select New Images</span>

        </label>

        <input
            type="file"
            id="variantImages"
            accept="image/*"
            name="images"
            multiple
            hidden>

    </div>

    <span class="error" id="imageError"></span>



    

</div>












</form>



<div
    class="modal fade"
    id="cropModal"
    tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    Save Image

                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">

                </button>

            </div>

            <div class="modal-body">

                   <img id="cropImage" style="max-width:100%;">
            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancel

                </button>

                <button
                    type="button"
                    id="cropButton"
                    class="btn btn-primary">

                   
                    Save Image

                </button>

            </div>

        </div>

    </div>

</div>



<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>



</main>

</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
const message = <%- JSON.stringify(message || null) %>;

if (message) {

    Swal.fire({
        icon: message.type,
        title: message.text,
        confirmButtonColor: "#096DB9",
        timer: 2000,
        showConfirmButton: false
    });

}
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/admin/js/edit-variant.js"></script>
</body>

</html>


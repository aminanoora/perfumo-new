<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/admin/css/users.css">

  <link rel="stylesheet" href="/admin/css/admin.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>

<body>
  <%- include('../partials/header') %>

    <div class="page">


      <%- include('../partials/sidebar') %>

        <main class="content">

          <div class="users-topbar">

            <div class="title">Users</div>

            <a href="/admin/users/add" class="add-user-btn">
              <i class="fa-solid fa-plus"></i>
              <span>Add User</span>
            </a>

            <form action="/admin/users" method="GET">
              <div class="search-box">

                <button class="btn btn-outline-primary" type="submit">
                  <i class="fa-solid fa-magnifying-glass "></i>
                </button>

                <input id="searchInput" type="search" class="form-control" placeholder="Search users..." name="search"
                  value="<%= search %>">




              </div>
            </form>

            <div class="btn-group">
              <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown"
                aria-expanded="false">
                <%= sort==='asc' ? 'Old Users First' : 'New Users First' %>
              </button>

              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item <%= sort === 'desc' ? 'active' : '' %>"
                    href="?page=<%= page %>&search=<%= search %>&status=<%= status %>&sort=desc">
                    New Users First
                  </a>
                </li>

                <li>
                  <a class="dropdown-item <%= sort === 'asc' ? 'active' : '' %>"
                    href="?page=<%= page %>&search=<%= search %>&status=<%= status %>&sort=asc">
                    Old Users First
                  </a>
                </li>
              </ul>
            </div>






            <div class="status-filters">

              <a href="/admin/users?status=all" class="active-link">
                <button data-status="all" class="active">
                  All
                </button>
              </a>



              <a href="/admin/users?status=active" class="active-link">
                <button data-status="active">
                  Active
                </button>
              </a>


              <a href="/admin/users?status=blocked" class="block-link ">
                <button data-status="blocked">
                  Blocked
                </button>
              </a>

            </div>

          </div>

          <div class="table-wrapper">


            <table class="users-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Orders</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody id="usersTable">

                <% users.forEach(user=> { %>
                  <tr data-id="<%= user._id %>" data-status="<%= user.isBlocked ? 'blocked' : 'active' %>"
                    data-date="<%= user.createdAt %>">
                    <td>
                      <div class="user-cell">
                        <div class="avatar">
                          <i class="fa-solid fa-user"></i>
                        </div>
                        <span>
                          <%= user.firstName %>
                            <%= user.lastName %>
                        </span>
                      </div>
                    </td>

                    <td>
                      <%= user.email %>
                    </td>

                    <td>
                      <%= user.orderCount || 0 %>
                    </td>

                    <td>
                      <% if(user.isBlocked){ %>
                        <span class="status blocked">Blocked</span>
                        <% } else { %>
                          <span class="status active">Active</span>
                          <% } %>
                    </td>

                    <td>
                      <div class="actions">
                        <button class="dots" type="button">
                          <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>

                        <div class="dropdown">
                          <a href="/admin/users/user-details/<%= user._id %>">View Details</a>
                        </div>



                      </div>
                    </td>
                  </tr>
                  <% }) %>

              </tbody>
            </table>
            <div class="pagination">

              <nav aria-label="User pagination">
                <ul class="pagination justify-content-center">

                  <% for(let i=1; i <=totalPages; i++) { %>
                    <li class="page-item <%= page === i ? 'active' : '' %>">
                      <a class="page-link"
                        href="/admin/users?page=<%= i %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>">
                        <%= i %>
                      </a>
                    </li>
                    <% } %>

                </ul>
              </nav>

            </div>
          </div>

        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/admin/js/users.js"></script>
</body>

</html>
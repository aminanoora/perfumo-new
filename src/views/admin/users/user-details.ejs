<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>User Details</title>

  <link rel="stylesheet" href="/admin/css/admin.css">
  <link rel="stylesheet" href="/admin/css/user-details.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

  <%- include('../partials/header') %>

    <div class="page">
      <%- include('../partials/sidebar') %>


        <main class="content">

          <div class="details-card">

            <div class="details-header">

              <div class="profile-section">

                <% if(user.profileImage){ %>

                  <img src="<%= user.profileImage %>" class="profile-img">

                  <% } else { %>

                    <div class="profile-placeholder">
                      <%= user.firstName.charAt(0).toUpperCase() %>
                    </div>

                    <% } %>

                      <div>
                        <h2>
                          <%= user.firstName %>
                            <%= user.lastName %>
                        </h2>

                        <p>
                          <%= user.email %>
                        </p>
                      </div>

              </div>

              <div class="status-badge <%= user.isBlocked ? 'blocked' : 'active' %>">
                <%= user.isBlocked ? 'Blocked' : 'Active' %>
              </div>

            </div>

            <form id="userForm" data-id="<%= user._id %>">

              <div class="form-grid">

                <div class="input-group">
                  <label>First Name</label>
                  <input type="text" name="firstName" value="<%= user.firstName %>">
                </div>

                <div class="input-group">
                  <label>Last Name</label>
                  <input type="text" name="lastName" value="<%= user.lastName %>">
                </div>

                <div class="input-group">
                  <label>Email</label>
                  <input type="email" value="<%= user.email %>" disabled>
                </div>

                <div class="input-group">
                  <label>Phone Number</label>
                  <input type="text" name="phone" value="<%= user.phone %>">
                </div>

              </div>

              <div class="address-wrapper">

                <h3>Addresses</h3>
                <% if(address && address.length> 0){ %>

                  <% address.forEach(addr=> { %>

                    <div>

                    </div>

                    <% }) %>

                      <% } else { %>

                        <p>No address found</p>

                        <% } %>
                          <% address.forEach(addr=> { %>

                            <div class="address-card">

                              <div class="form-grid">

                                <div class="input-group">
                                  <label>First Name</label>
                                  <input type="text" value="<%= addr.firstName %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>Last Name</label>
                                  <input type="text" value="<%= addr.lastName %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>Phone Number</label>
                                  <input type="text" value="<%= addr.phoneNumber %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>Pincode</label>
                                  <input type="text" value="<%= addr.pincode %>" disabled>
                                </div>

                                <div class="input-group full">
                                  <label>Street Address</label>
                                  <input type="text" value="<%= addr.streetAddress %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>City</label>
                                  <input type="text" value="<%= addr.city %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>State</label>
                                  <input type="text" value="<%= addr.state %>" disabled>
                                </div>

                                <div class="input-group">
                                  <label>Country</label>
                                  <input type="text" value="<%= addr.country %>" disabled>
                                </div>

                              </div>

                            </div>

                            <% }) %>

              </div>

              <div class="button-group">

                <button type="submit" class="save-btn">
                  Save User
                </button>

                <button type="button" id="blockBtn" class="block-btn" data-id="<%= user._id %>"
                  data-blocked="<%= user.isBlocked %>">

                  <%= user.isBlocked ? 'Unblock User' : 'Block User' %>

                </button>
                <button type="button" id="deleteBtn" class="delete-btn" data-id="<%= user._id %>">

                  Delete User

                </button>
              </div>

            </form>

          </div>

        </main>

    </div>

    <script src="/admin/js/user-details.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Forgot Password</title>

    <link rel="stylesheet" href="/user/css/forgot-password.css">

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Volkhov:wght@700&display=swap"
        rel="stylesheet"
    >
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body>

<section class="forgot-section">

    <div class="forgot-container">
       
        <div class="forgot-content">

            <h1 class="logo">
                PERFUMO
            </h1>

            <div class="forgot-box">

                <h2>
                    Forgot Password
                </h2>

                <form  id="forgotForm" action="/forgot-password" method="POST">

                    <div class="input-group">

                        <input
                            type="email"
                            name="email"
                            placeholder="Email Address"
                        
                        >

                    </div>

                    <button type="submit" class="send-btn">
                        Send Confirmation Code
                    </button>

                </form>

                <p class="login-text">

                    Already have an account?

                    <a href="/signin">
                        Login
                    </a>

                </p>

            </div>

            <p class="terms">
                PERFUMO Terms & Conditions
            </p>

        </div>

    </div>

</section>
<script>

const form =
document.getElementById('forgotForm');

form.addEventListener('submit',

async (e) => {

    e.preventDefault();

    const email =
    document.querySelector(
    '[name="email"]'
    ).value;

    try {

        const response =
        await fetch('/forgot-password', {

            method: 'POST',

            headers: {
                'Content-Type': 'application/json'
            },
                credentials: 'same-origin',
            body: JSON.stringify({
                email
            })
        });

        const data =
        await response.json();
          if(!email){
             Swal.fire({
                icon:'warning',
                title:"Email id required",

             })
          }
         else if(data.success){

            Swal.fire({
                icon: 'success',
                title: 'OTP Sent',
                text: 'Confirmation code sent to your email',
                timer: 1500,
                showConfirmButton: false
            });

            setTimeout(() => {

                window.location.href =
                data.next;

            }, 1500);

        } else {

            Swal.fire({
                icon: 'error',
                title: 'Email id does not exist ,try signing up ',
               
            });
        }

    } catch (error) {

        console.log(error);

        Swal.fire({
            icon: 'error',
            title: 'Something Went Wrong',
            text: 'Please try again'
        });
    }
});

</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Checkout</title>

    <link rel="stylesheet" href="/user/css/headers.css">
    <link rel="stylesheet" href="/user/css/footer.css">
    <link rel="stylesheet" href="/user/css/checkout.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

<%- include('../partials/header') %>

<section class="checkout-section">

    <div class="checkout-title">
        <h1>Checkout</h1>
    </div>

    <div class="checkout-container">

        <div class="checkout-left">

            <form id="checkoutForm"  action="/checkout/place-order"
    method="POST">

       <input
        type="hidden"
        name="redirectFrom"
        value="checkout">

                <section class="address-section">

                    <div class="section-heading">

                        <h2>Delivery Address</h2>

                        <a  href="/checkout/address/add-address?returnTo=checkout" class="add-address-btn">
                            + Add Address
                        </a>

                    </div>

                    <% if(addresses && addresses.length){ %>

                        <% addresses.forEach(address=>{ %>

                        <label class="address-card">

                           <input
    type="radio"
    name="addressId"
    value="<%= address._id %>"
    <%= address.isDefault ? "checked" : "" %>
>
                            <div class="address-details">

                                <h4>

                                   <%= address.firstName %> <%= address.lastName %>

                                    <% if(address.isDefault){ %>

                                    <span class="default-badge">

                                        Default

                                    </span>

                                    <% } %>

                                </h4>

                                <p>

                                      <%= address.streetAddress %>

                                </p>

                               
                           

                                <p>

                                    <%= address.city %>,
                                    <%= address.state %>

                                </p>

                                <p>

                                    <%= address.country %> -
                                    <%= address.pincode %>

                                </p>

                                <p>

                                   <%= address.phoneNumber %>

                                </p>

                            </div>

                            <div class="address-actions">

                                <a
                                   href="/checkout/address/edit-address/<%= address._id %>?returnTo=checkout">

                                    Edit

                                </a>

                            </div>

                        </label>

                        <% }) %>

                    <% }else{ %>

                    <div class="empty-address">

                        <i class="fa-solid fa-location-dot"></i>

                        <h3>

                            No Address Found

                        </h3>

                        <p>

                            Please add a delivery address.

                        </p>

                        <a
                            href="/checkout/address/add-address?returnTo=checkout"
                            class="add-address-btn">

                            Add Address

                        </a>

                    </div>

                    <% } %>

                </section>
                                <section class="payment-section">

                    <h2>Payment Method</h2>

                    <div class="payment-options">

                        <label class="payment-card">

                            <input
                                type="radio"
                                name="paymentMethod"
                                value="RAZORPAY"
                                checked>

                            <span class="payment-name">

                                Razorpay

                            </span>

                            <i class="fa-regular fa-credit-card"></i>

                        </label>

                        <label class="payment-card">

                            <input
                                type="radio"
                                name="paymentMethod"
                                value="COD">

                            <span class="payment-name">

                                Cash on Delivery

                            </span>

                            <i class="fa-solid fa-money-bill-wave"></i>

                        </label>

                        <label class="payment-card">

                            <input
                                type="radio"
                                name="paymentMethod"
                                value="WALLET">

                            <span class="payment-name">

                                Wallet

                            </span>

                            <i class="fa-solid fa-wallet"></i>

                        </label>

                    </div>

                    <% if(typeof wallet !== "undefined"){ %>

                    <div class="wallet-info">

                        Wallet Balance :

                        <strong>

                            ₹<%= wallet.balance.toLocaleString() %>

                        </strong>

                    </div>

                    <% } %>

                    <label class="save-info">

                        <input
                            type="checkbox"
                            name="saveInfo">

                        Save this information for future purchases

                    </label>

                </section>

                <div class="checkout-buttons">

                    <button
                        type="button"
                        id="payNowBtn"
                         class="place-order-btn"
                     >

                        Pay Now

                    </button>

                    

                </div>

            </form>

        </div>
        <div class="checkout-right">

    <div class="order-summary">

        <h2>Your Order</h2>

        <div class="order-items">

            <% cart.items.forEach(item=>{ %>

            <div class="order-item">

                <div class="order-image">

                    <img
                        src="/admin/uploads/products/<%= item.variant.images[0] %>"
                        alt="<%= item.variant.product.name %>">

                </div>

                <div class="order-item-details">

                    <h4>

                        <%= item.variant.product.name %>

                    </h4>

                    <p>

                        <%= item.variant.size %> ml •
                        <%= item.variant.concentration %>

                    </p>

                    <p>

                        Qty :
                        <strong>

                            <%= item.quantity %>

                        </strong>

                    </p>

                </div>

                <div class="order-item-price">

                    ₹<%= (item.variant.salePrice * item.quantity).toLocaleString() %>

                </div>

            </div>

            <% }) %>

        </div>

        <div class="coupon-section">

            <h3>

                Coupon / Referral Code

            </h3>

            <div class="coupon-box">

                <input
                    type="text"
                    id="couponCode"
                    placeholder="Enter coupon code">

                <button
                    type="button"
                    id="applyCoupon">

                    Apply

                </button>

            </div>

            <small id="couponMessage"></small>

        </div>

        <div class="price-details">

            <div class="price-row">

                <span>

                    Subtotal

                </span>

                <span>

                    ₹<%= subtotal.toLocaleString() %>

                </span>

            </div>

            <div class="price-row">

                <span>

                    Shipping

                </span>

                <span>

                    <% if(shipping===0){ %>

                        Free

                    <% }else{ %>

                        ₹<%= shipping.toLocaleString() %>

                    <% } %>

                </span>

            </div>

            <% if(typeof tax !== "undefined"){ %>

            <div class="price-row">

                <span>

                    Tax

                </span>

                <span>

                    ₹<%= tax.toLocaleString() %>

                </span>

            </div>

            <% } %>

            <div class="price-row">

                <span>

                    Discount

                </span>

                <span>

                    - ₹<%= discount.toLocaleString() %>

                </span>

            </div>

            <div class="price-row">

                <span>

                    Coupon Discount

                </span>

                <span id="couponDiscount">

                    - ₹0

                </span>

            </div>

            <hr>

            <div class="total-row">

                <span>

                    Grand Total

                </span>

                <span id="grandTotal">

                    ₹<%= grandTotal.toLocaleString() %>

                </span>

            </div>

        </div>

        <button
    type="submit"
    form="checkoutForm"
    id="placeOrderBtn"
    class="place-order-btn"
   
    >
    Place Order
</button>

    </div>

</div>

</div>

</section>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if(typeof message !== "undefined" && message){ %>

<script>

Swal.fire({

    icon: "<%= message.type %>",

    title:
        "<%= message.type==='success'
            ? 'Success'
            : message.type==='warning'
            ? 'Warning'
            : 'Error' %>",

    text: "<%= message.text %>",

    timer: 1800,

    showConfirmButton: false

});

</script>

<% } %>



<script src="/user/js/block-check.js"></script>
<script src="/user/js/checkout.js"></script>

</body>

</html>
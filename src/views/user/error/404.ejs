<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Page Not Found | Perfumo</title>

    <link rel="stylesheet" href="/user/css/404.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>

    <main class="error-page">

        <div class="error-container">


            <a href="/" class="logo">
                PERFUMO
            </a>


            <section class="error-content">

                <div class="error-number">
                    404
                </div>



                <h1>
                    INTERNAL SERVER ERROR
                </h1>

                <p>
                    We're having trouble processing your request. Please try again in a moment.
                </p>

                <a href="/" class="home-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Home
                </a>

            </section>

            <div class="decor decor-one"></div>
            <div class="decor decor-two"></div>

            <p class="copyright">
                © <%= new Date().getFullYear() %> Perfumo. All rights reserved.
            </p>

        </div>

    </main>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Confirm Password</title>

    <link
        rel="stylesheet"
        href="/user/css/confirm-email-password.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Volkhov:wght@700&display=swap"
        rel="stylesheet"
    >

</head>

<body>

<div class="profile-page">

    <aside class="sidebar">

        <div class="profile-user">

            <div class="profile-avatar">
                <%= user.firstName.charAt(0) %>
            </div>

            <h3>
                <%= user.firstName %>
                <%= user.lastName %>
            </h3>

        </div>


        <div class="sidebar-links">

            <a href="/orders">
                <i class="fa-regular fa-box"></i>
                My Orders
            </a>

            <a href="/wishlist">
                <i class="fa-regular fa-heart"></i>
                Wishlist
            </a>

            <a href="/address">
                <i class="fa-solid fa-location-dot"></i>
                Addresses
            </a>

            <a href="/coupons">
                <i class="fa-solid fa-ticket"></i>
                Coupons
            </a>

            <a href="/wallet">
                <i class="fa-solid fa-wallet"></i>
                My Wallet
            </a>

            <a href="/profile" class="active-link">
                <i class="fa-regular fa-user"></i>
                Profile Settings
            </a>

        </div>


        <a href="/logout" class="logout-btn">

            <i class="fa-solid fa-arrow-right-from-bracket"></i>

            Logout

        </a>

    </aside>


    <main class="profile-content">

        <div class="password-card">

            <h2>
                Confirm Your Password
            </h2>

            <p>
                For your security, confirm your password before changing your email.
            </p>


            <form id="confirmEmailPasswordForm">


                <div class="input-group">

                    <label>
                        ENTER YOUR PASSWORD
                    </label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                          
                        >

                        <i
                            class="fa-regular fa-eye toggle-password"
                            data-target="password">
                        </i>

                            <small
        class="field-error"
        id="passwordError">
    </small>

                    </div>

                </div>


                <div class="input-group">

                    <label>
                        CONFIRM YOUR PASSWORD
                    </label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm your password"
                            autocomplete="current-password"
                        
                        >

                        <i
                            class="fa-regular fa-eye toggle-password"
                            data-target="confirmPassword">
                        </i>

                        <small
        class="field-error"
        id="confirmPasswordError">
    </small>

                    </div>

                </div>


                <button
                    type="submit"
                    class="save-btn"
                    id="confirmBtn"
                >
                    Continue
                </button>


            </form>

        </div>

    </main>

</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/user/js/confirm-email-password.js"></script>

<script src="/user/js/block-check.js"></script>

</body>

</html>